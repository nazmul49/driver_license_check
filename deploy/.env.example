# Copy to deploy/.env with deploy/init-env.sh (it generates every secret). Never commit deploy/.env.

# Public hostname pointing at the VM, for example dlc-demo.duckdns.org
DLC_DOMAIN=
# Contact address for Let's Encrypt expiry notices
ACME_EMAIL=

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Application secrets. Back up ENCRYPTION_MASTER_KEY separately from database backups:
# without it, stored images and fields cannot be decrypted.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=k1
API_KEY_PEPPER=
HMAC_SECRET=
COOKIE_SECRET=
METRICS_TOKEN=

LOG_LEVEL=info
COOKIE_SECURE=true
HSTS=true
DESKTOP_HANDOFF_ENABLED=true
RETENTION_DEFAULT_DAYS=30
# 4 OCPU Ampere VM: 3 OCR workers per worker process, 2 sessions in parallel.
OCR_POOL_SIZE=3
WORKER_CONCURRENCY=2
