{
  "name": "@dlc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "tsx src/main.ts",
    "start:worker": "tsx src/worker.ts",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TZ=UTC vitest run",
    "test:unit": "TZ=UTC vitest run test/unit",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "ocr:accuracy": "TZ=UTC vitest run test/integration/ocr-accuracy.test.ts",
    "loadtest": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@dlc/database": "*",
    "@dlc/shared": "*",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "inversify": "^8.2.3",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.6",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.3",
    "supertest": "^7.1.4",
    "vitest": "^4.0.3"
  }
}
